# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/
venv/

# cr-renderer is a separate, external open-source project
# (https://github.com/CyberAgentAILab/cr-renderer), pulled in locally for
# reference/dev and installed by the engines via
# `pip install git+https://github.com/CyberAgentAILab/cr-renderer` — not
# vendored into this repo.
/cr-renderer/

# Generated run artifacts
output/*
!output/.gitkeep

# Tooling caches
.ruff_cache/
/tmp/
eval_out/
eval/cases/

# Optional vision-critic experiments: version manifests/configs, not weights or runs.
/local_models/
/training_runs/
/datasets/vision_critic/generated/
/datasets/vision_critic/cache/
/.venv-vision/
/.venv-vision-cpu/
/local_backups/

# Internal research, training plans and evaluation reports stay local.
# Keep public setup/API guides and asset/font license documentation tracked.
/reports/
