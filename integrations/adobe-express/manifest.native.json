{
  "testId": "chameleon-local-editable-reflow",
  "name": "Chameleon Local Reflow",
  "version": "0.1.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [{"name": "Express", "apiVersion": 1}],
    "supportsTouch": false,
    "experimentalApis": true
  },
  "entryPoints": [{
    "type": "panel",
    "id": "chameleon-panel",
    "main": "native-ui/index.html",
    "documentSandbox": "sandbox/code.js",
    "permissions": {"sandbox": ["allow-downloads"]}
  }]
}
